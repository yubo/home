[user]
	name = yubo
	email = yubo@yubo.org
[difftool]
	prompt = false
	trustExitCode = true
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
        cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[core]
	editor = nvim
	whitespace = tab-in-indent,trailing-space
	trustctime = false
	hooksPath = /Users/yubo/.ccm/git-hooks
[alias]
	s = show --color --pretty=format:%b
	d = "!f() { if [ \"$#\" -eq 1 ]; then case \"$1\" in c) git difftool --cached ;; h) git difftool HEAD^ HEAD ;; -*) git difftool \"$@\" ;; *) git difftool \"$1^\" \"$1\" ;; esac; else git difftool \"$@\"; fi; }; f"
	df = "!f() { git diff --name-status \"$1^\" \"$1\"; }; f"
	co = checkout
	cm = commit
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	l = log --oneline --decorate -12 --color
	ll = log --oneline --decorate --color
	lc = log --graph --color
	sbi = submodule init
	sbu = submodule update
	sbp = submodule foreach git pull
	sbc = submodule foreach git co master
	# skip worktree
	k = update-index --skip-worktree
	nk = update-index --no-skip-worktree
	ls = ls-files -v

[push]
	default = upstream
[color]
	ui = auto
[credential]
	helper = cache --timeout 2592000
[include]
	#path = ~/.gitconfig.local
[pull]
	rebase = false
